# xAI / Grok (never commit real secrets)
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT_SECONDS=20
XAI_MAX_RETRIES=1
XAI_MAX_TOKENS=1024
POLISH_WITH_GROK=true

# Agent service
AGENT_PORT=8001

# Financial Engine
ENGINE_BASE_URL=http://localhost:8000
# fake = R1 deterministic FakeFinanceTools
# http = real FastAPI engine (no silent fallback to fake)
ENGINE_MODE=fake

# Trace persistence
# auto = supabase if credentials present, otherwise memory
# memory = always in-memory (explicit for local/tests)
# supabase = require SUPABASE_* credentials
TRACE_BACKEND=auto
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
